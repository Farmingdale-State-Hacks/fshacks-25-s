    "auth": "pnpm dlx @better-auth/cli@latest",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --y --output ./lib/server/schema/auth.schema.ts && prettier --write ./lib/server/schema/auth.schema.ts",
    "build": "bun install && vinxi build --preset vercel",
    "build:test": "VINXI_PRESET=node-server vinxi build --preset node-server && node scripts/patch-nitro.js",
    "db": "drizzle-kit",
    "dev": "vinxi dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "start": "node .output/server/index.mjs",
    "ui": "pnpm dlx shadcn@canary",
    "e2e:ci": "PLAYWRIGHT_TIMEOUT=120000 PLAYWRIGHT_WEBSERVER_TIMEOUT=180000 bun run playwright test",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "cypress:ci": "cypress run --browser chrome",
    "cypress:run:component": "cypress run --component",
    "test": "bun run e2e:ci && bun run cypress:ci",
    "test:e2e": "PLAYWRIGHT_TIMEOUT=120000 PLAYWRIGHT_WEBSERVER_TIMEOUT=180000 playwright test",
    "test:cypress": "cypress run",
    "test:ci": "bun run test",
    "doctor": "npx react-doctor@latest"
